#!/bin/bash -e

# Fly mounts an initially root-owned volume. Rails runs as an unprivileged user.
if [ "$(id -u)" = "0" ]; then
  mkdir -p /data
  chown rails:rails /data
  exec gosu rails "$0" "$@"
fi

if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
  export LD_PRELOAD
fi

# SQLite migrations must run on the machine with the mounted volume.
if [ "$1" = "supervisord" ] || { [ "${@: -2:1}" = "./bin/rails" ] && [ "${@: -1:1}" = "server" ]; }; then
  ./bin/rails db:prepare
fi

exec "$@"
