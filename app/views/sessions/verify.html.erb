<% content_for :title, "Enter your code" %>
<div class="form-page narrow">
  <h1>Check your email</h1>
  <p>Enter the six-digit code we sent you. It expires in ten minutes.</p>
  <% if @error %><p role="alert"><%= @error %></p><% end %>
  <%= form_with url: verify_login_path do |form| %>
    <div class="field"><%= form.label :code, "Login code" %><%= form.text_field :code, required: true, inputmode: "numeric", autocomplete: "one-time-code", pattern: "[0-9]{6}", maxlength: 6 %></div>
    <%= form.submit "Verify and continue", class: "button" %>
  <% end %>
  <p><%= link_to "Request another code", login_path %></p>
</div>
