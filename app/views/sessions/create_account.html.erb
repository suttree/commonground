<% content_for :title, "Create account" %>
<div class="form-page narrow">
  <h1>Create your account</h1>
  <p>Your profile has been saved. Verify the email address you used to manage your profile and save your SDG quiz answers.</p>
  <p>If you already have an account, use the same email to add this profile to it.</p>
  <%= form_with url: login_path do |form| %>
    <%= hidden_field_tag :signup, "1" %>
    <div class="field"><%= form.label :email, "Email address" %><%= form.email_field :email, value: @pending_submission.email, readonly: true, required: true, autocomplete: "email", maxlength: 254 %></div>
    <%= form.submit "Send verification code", class: "button" %>
  <% end %>
</div>
