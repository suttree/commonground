<% content_for :title, "Create account" %>
<div class="form-page narrow">
  <h1>Create your account</h1>
  <p>Your profile has been saved. Confirm or change your email address, then verify it to manage your profile and save your SDG quiz answers.</p>
  <p>Already have a profile? <%= link_to "Log in to edit it", login_path %>.</p>
  <% if @error %><p role="alert"><%= @error %></p><% end %>
  <%= form_with url: login_path do |form| %>
    <%= hidden_field_tag :signup, "1" %>
    <div class="field"><%= form.label :email, "Email address" %><%= form.email_field :email, value: @email || @pending_submission.email, required: true, autocomplete: "email", maxlength: 254 %></div>
    <%= form.submit "Send verification code", class: "button" %>
  <% end %>
</div>
