<% content_for :title, "What are you working towards?" %>
<section class="home-opening campaign-opening" aria-labelledby="hero-title">
  <div class="opening-context">
    <h1 id="hero-title">What are you working towards?</h1>
    <p class="opening-questions">
      <span>Not your job title.</span>
      <span>Not your next promotion.</span>
      <span>Not another PowerPoint.</span>
    </p>
  </div>
  <div class="opening-invitation">
    <p class="intro">The problem you want to solve. The change you want to create. The impact you want to have.</p>
    <p>Commonbound is building a new way to connect people and companies and organizations around meaningful work.</p>
    <h2 class="join-heading">Tell us what you’re here to change.</h2>
    <nav class="opening-links" aria-label="Join Commonbound">
      <%= link_to new_person_path do %><span>Create a profile</span><span aria-hidden="true">→</span><% end %>
      <%= link_to people_path do %><span>Find a collaborator</span><span aria-hidden="true">→</span><% end %>
    </nav>
  </div>
</section>

<section class="directory-invitation"><h2>Find problems worth working on</h2><p>Explore the <%= link_to "Sustainable Development Goals directory", sdgs_path %>, browse <%= link_to "people", people_path %> or find <%= link_to "companies", companies_path %>.</p></section>
