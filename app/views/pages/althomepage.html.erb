      <path d="M40 260h240v240H40z" fill="#2d50bd"/>
      <path d="M40 500a120 120 0 0 1 240 0" fill="#f2eee3"/>
      <path d="M280 260h240v240H280z" fill="#f5ce43"/>
      <circle cx="400" cy="380" r="88" fill="#f2eee3"/>
      <!-- Two people carry a shared piece of the structure. -->
      <path d="m154 304-23 118-34 109h39l49-97 24-94Z" fill="#20211f"/>
      <path d="m186 324 22 106 53 87 31-19-43-96-6-96Z" fill="#20211f"/>
      <path d="m97 531-24 19h64l-1-19m125-14 8 26 47-28-24-17" fill="#20211f"/>
      <path d="M159 217c-19 27-25 59-29 105l110 11-9-80-38-43Z" fill="#e74b32"/>
      <path d="m157 226-40 58 17 22 60-46m30-18 43 37 60-78" fill="none" stroke="#be7954" stroke-width="23" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="m165 220-31 44 34 24 36-44m9-14 32 31-28 32-35-36" fill="#e74b32"/>
      <path d="m181 189-5 33 25 7 8-34" fill="#be7954"/>
      <ellipse cx="198" cy="177" rx="26" ry="32" fill="#be7954"/>
      <path d="M171 185c-15-48 39-61 54-26l-24-3-8 24-13-5-2 14Z" fill="#20211f"/>
      <path d="m382 357-20 94-23 105h38l37-98 16-92m-11-3 17 105 51 85 30-20-40-88-4-96" fill="#2d50bd"/>
      <path d="m339 556-19 20h58v-20m109-3 7 25 50-29-27-16" fill="#20211f"/>
      <path d="m393 256-21 109 107 4-22-101-30-20Z" fill="#f2eee3" stroke="#20211f" stroke-width="2"/>
      <path d="m397 273-32 35-47-109m123 76 38 25 15-112" fill="none" stroke="#d69b78" stroke-width="22" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="m391 260-22 31 31 25 22-40m14-17 32 20-16 35-31-33" fill="#f2eee3" stroke="#20211f" stroke-width="2"/>
      <path d="m409 232-3 28 24 4 3-32" fill="#d69b78"/>
      <ellipse cx="422" cy="215" rx="25" ry="31" fill="#d69b78"/>
      <path d="M396 212c-5-32 23-49 47-24l-2 24-17-17-23 22Z" fill="#20211f"/>
      <path d="M300 167h210v30H300z" fill="#20211f"/>
      <path d="M40 590h480" stroke="#20211f" stroke-width="2"/>
      <circle cx="52" cy="566" r="12" fill="#e74b32"/>
      <path d="m66 58 25-25m-25 0 25 25" stroke="#20211f" stroke-width="3"/>
    </svg>
    <p>A shared purpose. A different way to work.</p>
  </div>
</section>

<section class="bauhaus-join" id="join" aria-labelledby="join-title">
  <div class="bauhaus-join-copy">
    <p class="bauhaus-kicker">Different skills. Common purpose.</p>
    <h2 id="join-title">Find your <br>people.</h2>
    <p>Commonbound connects people with companies and each other around the problems they want to solve.</p>
    <p>Tell us what you're working towards.</p>
  </div>
  <nav class="bauhaus-choices" aria-label="Join Commonbound">
    <%= link_to new_person_path, class: "bauhaus-choice bauhaus-person" do %>
      <span class="bauhaus-choice-top"><span>For people</span><span aria-hidden="true">↗</span></span>
      <span class="bauhaus-choice-title">I'm interested<br>in helping</span>
      <span class="bauhaus-choice-note">Bring your skills to a problem you care about.</span>
    <% end %>
    <%= link_to new_organisation_path, class: "bauhaus-choice bauhaus-company" do %>
      <span class="bauhaus-choice-top"><span>For organisations</span><span aria-hidden="true">↗</span></span>
      <span class="bauhaus-choice-title">I need<br>someone</span>
      <span class="bauhaus-choice-note">Find people who share your purpose.</span>
    <% end %>
  </nav>
</section>

<section class="bauhaus-explore" aria-labelledby="explore-title">
  <div class="bauhaus-explore-symbol" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div><p class="bauhaus-kicker">Start with what matters to you</p><h2 id="explore-title">Find problems worth working on.</h2><p>Explore the Sustainable Development Goals and the people working towards them.</p>
  <nav aria-label="Explore Commonbound"><%= link_to sdgs_path do %>Explore the goals <span aria-hidden="true">↗</span><% end %><%= link_to "Meet the people", people_path %><%= link_to "Find companies", companies_path %></nav></div>
</section>
