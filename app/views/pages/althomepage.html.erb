<% content_for :title, "Your job title doesn't define your impact." %>
<% content_for :body_class, "bauhaus-page" %>
<section class="bauhaus-hero" aria-labelledby="hero-title">
  <div class="bauhaus-message">
    <p class="bauhaus-kicker"><span aria-hidden="true"></span> Good work starts with common ground</p>
    <h1 id="hero-title">Your job title<br>doesn't define<br>your <span>impact.</span></h1>
    <p class="bauhaus-intro">The age of AI calls for people who want to solve problems, build expertise, and create work that matters.</p>
    <a class="bauhaus-jump" href="#join">Find your place <span aria-hidden="true">↗</span></a>
  </div>
  <div class="bauhaus-art" aria-hidden="true">
    <svg viewBox="0 0 560 620" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <defs>
        <pattern id="bauhaus-lines" width="12" height="12" patternUnits="userSpaceOnUse">
          <path d="M0 0V12" stroke="#20211f" stroke-width="2"/>
        </pattern>
        <filter id="paper-raised" x="-35%" y="-35%" width="180%" height="190%" color-interpolation-filters="sRGB">
          <feDropShadow dx="7" dy="12" stdDeviation="7" flood-color="#403525" flood-opacity=".2" result="cast-shadow"/>
          <feDropShadow in="SourceGraphic" dx="2" dy="3" stdDeviation="0" flood-color="#403525" flood-opacity=".28" result="edge"/>
          <feMerge><feMergeNode in="cast-shadow"/><feMergeNode in="edge"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="paper-layer" x="-40%" y="-40%" width="190%" height="200%" color-interpolation-filters="sRGB">
          <feDropShadow dx="3" dy="5" stdDeviation="3" flood-color="#30291f" flood-opacity=".27"/>
        </filter>
        <g id="red-petals">
          <circle cx="195" cy="108" r="64"/>
          <circle cx="270" cy="152" r="64"/>
          <circle cx="270" cy="238" r="64"/>
          <circle cx="195" cy="282" r="64"/>
          <circle cx="120" cy="238" r="64"/>
          <circle cx="120" cy="152" r="64"/>
        </g>
        <path id="blue-petals" d="M402 205c-58-50-104 12-58 58-73 9-63 87 3 86-30 65 42 99 69 40 34 61 103 18 66-40 68-9 63-86-8-86 39-57-25-108-72-58Z"/>
      </defs>
      <circle filter="url(#paper-raised)" cx="449" cy="95" r="49" fill="#f5ce43"/>
      <path d="M195 235v315M402 342v208" stroke="#20211f" stroke-width="12"/>
      <path filter="url(#paper-raised)" d="M195 440A132 132 0 0 1 63 308a132 132 0 0 1 132 132Z" fill="#2d50bd"/>
      <path d="M63 308 195 440A132 132 0 0 1 63 308Z" fill="#fff9ed" opacity=".14"/>
      <path d="M195 494A132 132 0 0 0 327 362a132 132 0 0 0-132 132Z" fill="url(#bauhaus-lines)"/>
      <path filter="url(#paper-raised)" d="M402 495a92 92 0 0 1-92-92 92 92 0 0 1 92 92Z" fill="#e74b32"/>
      <path filter="url(#paper-raised)" d="M402 438a92 92 0 0 0 92-92 92 92 0 0 0-92 92Z" fill="#f5ce43"/>
      <path d="m310 403 92 92a92 92 0 0 1-92-92Z" fill="#fff9ed" opacity=".17"/>
      <path d="m494 346-92 92a92 92 0 0 0 92-92Z" fill="#fff9ed" opacity=".2"/>
      <!-- Each smaller cutout sits above the darker paper beneath it. -->
      <use href="#red-petals" fill="#ab3528" filter="url(#paper-raised)"/>
      <use href="#red-petals" fill="#d94a34" transform="translate(195 190) scale(.86) translate(-195 -195)" filter="url(#paper-layer)"/>
      <use href="#red-petals" fill="#ee6447" transform="translate(193 185) scale(.70) translate(-195 -195)" filter="url(#paper-layer)"/>
      <circle filter="url(#paper-layer)" cx="191" cy="180" r="49" fill="#f5ce43"/>
      <circle filter="url(#paper-layer)" cx="189" cy="177" r="17" fill="#20211f"/>
      <use href="#blue-petals" fill="#203779" filter="url(#paper-raised)"/>
      <use href="#blue-petals" fill="#2d50bd" transform="translate(409 296) scale(.84) translate(-411 -300)" filter="url(#paper-layer)"/>
      <use href="#blue-petals" fill="#5575d3" transform="translate(407 291) scale(.67) translate(-411 -300)" filter="url(#paper-layer)"/>
      <circle filter="url(#paper-layer)" cx="405" cy="287" r="32" fill="#f2eee3"/>
      <circle filter="url(#paper-layer)" cx="403" cy="284" r="11" fill="#20211f"/>
      <path d="M40 550h480v40H40z" fill="#20211f"/>
      <path filter="url(#paper-raised)" d="M60 590a135 135 0 0 1 270 0" fill="#f5ce43"/>
      <path d="m358 74 22-22m-22 0 22 22" stroke="#20211f" stroke-width="3"/>
    </svg>
    <p>A shared purpose. A different way to work.</p>
  </div>
</section>

<section class="bauhaus-join" id="join" aria-labelledby="join-title">
  <div class="bauhaus-join-copy">
    <p class="bauhaus-kicker">Different skills. Common purpose.</p>
    <h2 id="join-title">Find your <br>people.</h2>
    <p>Commonbound connects people with companies and each other around the problems they want to solve.</p>
    <p>Tell us what you're working towards.</p>
  </div>
  <nav class="bauhaus-choices" aria-label="Join Commonbound">
    <%= link_to new_person_path, class: "bauhaus-choice bauhaus-person" do %>
      <span class="bauhaus-choice-top"><span>For people</span><span aria-hidden="true">↗</span></span>
      <span class="bauhaus-choice-title">Create<br>a profile</span>
      <span class="bauhaus-choice-note">Bring your skills to a problem you care about.</span>
    <% end %>
    <%= link_to people_path, class: "bauhaus-choice bauhaus-company" do %>
      <span class="bauhaus-choice-top"><span>Find your people</span><span aria-hidden="true">↗</span></span>
      <span class="bauhaus-choice-title">Find a<br>collaborator</span>
      <span class="bauhaus-choice-note">Find people who share your purpose.</span>
    <% end %>
  </nav>
</section>

<section class="bauhaus-explore" aria-labelledby="explore-title">
  <div class="bauhaus-explore-symbol" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div><p class="bauhaus-kicker">Start with what matters to you</p><h2 id="explore-title">Find problems worth working on.</h2><p>Explore the Sustainable Development Goals and the people working towards them.</p>
  <nav aria-label="Explore Commonbound"><%= link_to sdgs_path do %>Explore the goals <span aria-hidden="true">↗</span><% end %><%= link_to "Meet the people", people_path %><%= link_to "Find companies", companies_path %></nav></div>
</section>

<%= render "challenges/recent", challenges: @recent_challenges %>
