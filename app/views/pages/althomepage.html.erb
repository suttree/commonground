<% content_for :title, "Your job title doesn't define your impact." %>
<% content_for :body_class, "bauhaus-page" %>
<section class="bauhaus-hero" aria-labelledby="hero-title">
  <div class="bauhaus-message">
    <p class="bauhaus-kicker"><span aria-hidden="true"></span> Good work starts with common ground</p>
    <h1 id="hero-title">Your job title<br>doesn't define<br>your <span>impact.</span></h1>
    <p class="bauhaus-intro">The age of AI calls for people who want to solve problems, build expertise, and create work that matters.</p>
    <a class="bauhaus-jump" href="#join">Find your place <span aria-hidden="true">↗</span></a>
  </div>
  <div class="bauhaus-art" aria-hidden="true">
    <svg viewBox="0 0 560 620" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <defs><pattern id="bauhaus-lines" width="14" height="14" patternUnits="userSpaceOnUse"><path d="M0 0V14" stroke="#20211f" stroke-width="2"/></pattern></defs>
      <path fill="#e74b32" d="M280 20a240 240 0 0 1 240 240H280Z"/>
