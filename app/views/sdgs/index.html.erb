<% content_for :title, "SDG directory" %>
<div class="sdg-directory">
  <header class="sdg-intro">
    <p class="eyebrow">The Commonbound reference</p>
    <h1>A guide to the goals.</h1>
    <p class="intro">Explore the problems behind the Sustainable Development Goals. Find a topic, understand its targets and share a reference.</p>
    <p class="small-note">17 goals · 169 targets</p>
  </header>
  <%= form_with url: sdgs_path, method: :get, class: "sdg-search", role: "search" do %>
    <div><%= label_tag :q, "Search the directory" %><%= search_field_tag :q, @query, placeholder: "Try housing, food waste or 12.6", maxlength: 120 %></div>
    <div><%= label_tag :goal, "Filter by goal" %><%= select_tag :goal, options_for_select([["All goals", ""]] + ProfileOptions::GOALS.map { |goal| ["#{goal.fetch('id')}. #{goal.fetch('name')}", goal.fetch('id')] }, @goal_id) %></div>
    <button class="button">Search</button>
  <% end %>
  <% if @searching %>
    <div class="sdg-results-heading"><h2><%= pluralize(@count, "target") %> found</h2><%= link_to "Clear search", sdgs_path %></div>
    <% if @results.empty? %><p class="empty-state">No targets match these words. Try a broader term such as water, education or work, or choose another goal.</p><% else %>
      <p class="small-note"><% if @query.present? %>Results for “<%= @query %>”. <% end %>Page <%= @page %> of <%= @pages %>.</p>
      <div class="sdg-target-grid">
        <% @results.each do |entry| %>
          <article class="sdg-target-card">
            <p class="eyebrow">Goal <%= entry[:goal].fetch("id") %> · <%= entry[:goal].fetch("name") %></p>
            <h3><%= link_to "#{entry[:target].fetch('id')} · #{entry[:label]}", sdg_target_path(entry[:target].fetch("id")) %></h3>
            <p><%= truncate(entry[:target].fetch("text"), length: 210, separator: " ") %></p>
          </article>
        <% end %>
      </div>
      <% if @pages > 1 %><nav class="sdg-pagination" aria-label="Search result pages">
        <% if @page > 1 %><%= link_to "Previous page", sdgs_path(q: @query, goal: @goal_id, page: @page - 1) %><% end %>
        <span>Page <%= @page %> of <%= @pages %></span>
        <% if @page < @pages %><%= link_to "Next page", sdgs_path(q: @query, goal: @goal_id, page: @page + 1) %><% end %>
      </nav><% end %>
    <% end %>
  <% else %>
    <nav class="sdg-prompts" aria-label="Example searches"><span class="small-note">Start with a topic:</span><% ["Food", "Housing", "Climate", "Equal pay", "Biodiversity"].each do |term| %><%= link_to term, sdgs_path(q: term) %><% end %></nav>
    <h2 class="sdg-section-title">Browse the 17 goals</h2>
    <div class="sdg-goal-grid">
      <% ProfileOptions::GOALS.each do |goal| %>
        <% guide = SdgDirectory::GUIDES.fetch(goal.fetch("id")) %>
        <article class="sdg-goal-card sdg-color-<%= goal.fetch('id') %>">
          <p class="eyebrow">Goal <%= goal.fetch("id") %> · <%= goal.fetch("targets").size %> targets</p>
          <h2><%= link_to goal.fetch("name"), sdg_goal_path(goal.fetch("id")) %></h2>
          <p><%= guide.fetch("summary") %></p>
        </article>
      <% end %>
    </div>
  <% end %>
  <%= render "source" %>
</div>
