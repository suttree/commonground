<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Common Ground" : "Common Ground · Work worth doing, together" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Find people through what needs doing and why it matters. Personal introductions for people and organisations.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap<%= " home-header" if controller_name == "pages" && action_name == "home" %>">
      <%= link_to root_path, class: "wordmark", aria: { label: "Common Ground home" } do %><span class="brand-mark" aria-hidden="true">cg.</span> Common Ground<% end %>
      <span class="pilot-label">An early experiment in finding work</span>
    </header>
    <main id="main" class="wrap" tabindex="-1">
      <% if notice %><p class="notice" role="status"><%= notice %></p><% end %>
      <%= yield %>
    </main>
    <footer class="site-footer wrap">
      <p>Good work starts with a conversation.</p>
      <%= link_to "Privacy & your details", privacy_path %>
    </footer>
  </body>
</html>
