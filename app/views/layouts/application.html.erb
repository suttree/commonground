<!DOCTYPE html>
<html lang="en">
  <head>
    <title><% if content_for?(:title) %><%= yield(:title) %> · Commonbound<% else %>Commonbound · Work worth doing, together<% end %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Commonbound connects people and organisations around meaningful work and the problems they want to solve.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <% unless %w[invitations collaborator_invitations].include?(controller_name) %><script src="https://scripts.withcabin.com/hello.js" async defer></script><% end %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
  </head>
  <%# app-page scopes the mobile layout; the marketing pages and project-detail pages keep their own. %>
  <% body_classes = [ (yield(:body_class) if content_for?(:body_class)), ("app-page" unless controller_name == "pages" || (controller_name == "profiles" && action_name == "project") || (controller_name == "challenges" && action_name == "show")) ].compact_blank.join(" ") %>
  <body<% if body_classes.present? %> class="<%= body_classes %>"<% end %>>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap<%= " home-header" if controller_name == "pages" && %w[home althomepage].include?(action_name) %>">
      <% blog = link_to("Blog", "https://commonbound.pika.page/", target: "_blank", rel: "noopener") %>
      <% if current_account %>
        <%= link_to(dashboard_path, class: "wordmark", aria: { label: "Commonbound dashboard" }) do %><%= image_tag "commonbound-logo.jpg", class: "brand-mark", alt: "", width: 44, height: 44 %> Commonbound<% end %>
        <%# Small screens: the menu button reveals both groups. Without JavaScript the links stay visible. %>
        <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-menu" hidden data-nav-toggle>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span>Menu</span>
        </button>
        <div class="site-menu" id="site-menu">
          <nav class="nav-group" aria-label="Main navigation">
            <%= main_navigation_link "Dashboard", dashboard_path, section: :dashboard, class: "nav-menu-only" %>
            <%= main_navigation_link "Discover", challenges_path, section: :discover %>
            <%= main_navigation_link "Goals", sdgs_path, section: :goals %>
            <%= blog %>
          </nav>
          <nav class="nav-group" aria-label="Account">
            <% if current_account.admin? %><%= main_navigation_link "Admin", admin_root_path, section: :admin %><% end %>
            <%= link_to (current_profile&.display_name.presence || "Your profile"), edit_account_profile_path, class: "button small ghost nav-account" %>
          </nav>
        </div>
        <%= javascript_include_tag "site_menu", defer: true %>
      <% else %>
        <%= link_to(root_path, class: "wordmark", aria: { label: "Commonbound home" }) do %><%= image_tag "commonbound-logo.jpg", class: "brand-mark", alt: "", width: 44, height: 44 %> Commonbound<% end %>
        <nav aria-label="Main navigation">
          <span class="nav-group"><%= main_navigation_link "About", about_path, section: :about %><%= blog %></span>
          <span class="nav-group"><%= main_navigation_link "Discover", challenges_path, section: :discover %><%= main_navigation_link "Goals", sdgs_path, section: :goals %></span>
          <%= link_to "Log in", login_path, class: "button small ghost nav-login" %>
        </nav>
      <% end %>
    </header>
    <main id="main" class="wrap" tabindex="-1">
      <% if notice %><p class="notice" role="status"><%= notice %></p><% end %>
      <% if alert %><p class="error-summary" role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
    <footer class="site-footer wrap">
      <p>Good work starts with a conversation.</p>
      <nav class="footer-links" aria-label="Footer">
        <%= link_to "About", about_path %>
        <%= link_to "Blog", "https://commonbound.pika.page/", target: "_blank", rel: "noopener" %>
        <%= link_to "Privacy & your details", privacy_path %>
      </nav>
    </footer>
  </body>
</html>
