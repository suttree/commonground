<!DOCTYPE html>
<html lang="en">
  <head>
    <title><% if content_for?(:title) %><%= yield(:title) %> · Commonbound<% else %>Commonbound · Work worth doing, together<% end %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Commonbound connects people and organisations around meaningful work and the problems they want to solve.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <script src="https://scripts.withcabin.com/hello.js" async defer></script>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
  </head>
  <body<% if content_for?(:body_class) %> class="<%= yield(:body_class) %>"<% end %>>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap<%= " home-header" if controller_name == "pages" && %w[home althomepage about].include?(action_name) %>">
      <%= link_to(current_account ? dashboard_path : root_path, class: "wordmark", aria: { label: current_account ? "Commonbound dashboard" : "Commonbound home" }) do %><span class="brand-mark" aria-hidden="true">cb.</span> Commonbound<% end %>
      <nav aria-label="Main navigation"><%= link_to "Goals", sdgs_path %> <%= link_to "About", about_path %> <%= link_to "Blog", "https://commonbound.pika.page/" %> <% if current_account %><%= link_to "Dashboard", dashboard_path %> <%= button_to "Log out", logout_path, method: :delete, class: "nav-logout" %><% else %><%= link_to "Log in", login_path %><% end %></nav>
    </header>
    <main id="main" class="wrap" tabindex="-1">
      <% if notice %><p class="notice" role="status"><%= notice %></p><% end %>
      <%= yield %>
    </main>
    <footer class="site-footer wrap">
      <p>Good work starts with a conversation.</p>
      <%= link_to "Privacy & your details", privacy_path %>
    </footer>
  </body>
</html>
