<header class="member-opening">
  <div class="member-heading">
    <% if @profile.location.present? %><p class="profile-location"><%= @profile.location %><% if @profile.radius_km.present? %> · Within <%= @profile.radius_km %> km<% end %></p><% end %>
    <h1><%= @profile.display_name %></h1>
    <% if @profile.skills_summary.present? %><div class="member-introduction"><%= simple_format @profile.skills_summary %></div><% end %>
    <p class="member-availability">
      <span class="availability-dot <%= 'is-open' if Submission::AVAILABILITY_STATUSES.first(2).include?(@profile.availability_status) %>" aria-hidden="true"></span>
      <span><%= @profile.availability_status.presence || (owns_profile?(@profile) ? "Availability not added" : "Availability not shared") %></span>
      <% if owns_profile?(@profile) %><%= link_to @profile.availability_status.present? ? "Update" : "Add availability", edit_account_profile_path(section: "future", profile_id: @profile.id, anchor: "submission_availability_status") %><% end %>
    </p>
  </div>
  <%= render "shared/member_identity", profile: @profile %>
  <div class="member-actions">
    <% if @profile.contact_link.present? %><%= link_to @profile.contact_action, @profile.contact_link, class: "button member-contact", rel: "noopener noreferrer" %><% end %>
    <% if @profile.website.to_s.match?(%r{\Ahttps?://}i) %><%= link_to "Website & work ↗", @profile.website, target: "_blank", rel: "noopener noreferrer", class: "profile-website" %><% end %>
  </div>
</header>
