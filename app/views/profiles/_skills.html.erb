<% skills = profile.profile_entries("skills") %>
<% if skills.any? %>
  <section class="profile-section" id="skills" aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills in practice</h2>
    <ol class="skill-list">
      <% skills.each_with_index do |skill, index| %>
        <li id="skill-<%= index + 1 %>">
          <h3><%= link_to skill["skill"], people_path(skill: skill["skill"]) %></h3>
          <% context = [skill["organisation"], skill["time"]].compact_blank %>
          <% if context.any? %><p class="small-note"><%= context.join(" · ") %></p><% end %>
          <p><%= truncate(strip_tags(skill["results"].to_s).squish, length: 180, separator: " ") %></p>
          <p class="small-note"><%= link_to "Read more →", profile_skill_path(profile.public_slug, index + 1), aria: { label: "Read more about #{skill['skill']}" } %></p>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
