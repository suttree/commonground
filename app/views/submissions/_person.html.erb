<fieldset>
  <legend>People & problems</legend>
  <%= render "text_field", form: form, attribute: :purpose, label: "People I strive to serve with my work", required: true, hint: "Tell us about the social group or community you want to serve." %>
  <%= render "text_field", form: form, attribute: :location, label: "Where are the people I want to serve?", hint: "Name a place or region, or say anywhere. This is the community you want to serve, rather than a commuting preference.", rows: 2 %>
  <div class="field">
    <%= form.label :radius_km, "Radius around that location, in kilometres (optional)" %>
    <%= form.number_field :radius_km, min: 0, max: 20000, step: "any", **field_options(@submission, :radius_km) %>
    <%= render "shared/field_error", record: @submission, attribute: :radius_km %>
  </div>
  <%= render "shared/priorities", form: form if @submission.persisted? %>
</fieldset>
<fieldset>
  <legend>Experience & direction</legend>
  <%= render "text_field", form: form, attribute: :experience, label: "The underlying thread in my experiences", required: true, hint: "What connects the work and experiences that matter to you? A short answer is enough." %>
  <%= render "sectors", form: form, attribute: :sectors_past, label: "Sectors I have worked in" %>
  <%= render "sectors", form: form, attribute: :sectors_future, label: "Sectors I wish to move into" %>
  <%= render "text_field", form: form, attribute: :sector_reason, label: "And why?", hint: "What draws you towards those sectors?" %>
</fieldset>
<%= render "repeated", form: form, field: "skills", title: "Skills I can verify through results", singular: "Skill" %>
<fieldset>
  <legend>Learning & perspective</legend>
  <%= render "text_field", form: form, attribute: :education_topics, label: "Topics that impacted my thinking during my education", hint: "Write a list, with one topic per line. You can add paragraphs to explain each topic.", rows: 6 %>
</fieldset>
<section aria-labelledby="optional-sections-title" class="optional-sections">
  <h2 id="optional-sections-title">More about you</h2>
  <p>Choose either section, both, or neither.</p>
  <details <%= "open" if @submission.satisfaction_feeling.present? || @submission.satisfaction_notes.present? %>>
    <summary>When I feel most alive, satisfied or at peace</summary>
    <fieldset class="choice-group" id="submission_satisfaction_feeling" tabindex="-1">
      <legend>I feel most…</legend>
      <div class="feeling-choices">
        <% ProfileOptions::FEELINGS.each do |feeling| %>
          <div class="feeling-choice"><%= form.radio_button :satisfaction_feeling, feeling %><%= form.label :satisfaction_feeling, feeling, value: feeling %></div>
        <% end %>
        <div class="feeling-choice"><%= form.radio_button :satisfaction_feeling, "" %><%= form.label :satisfaction_feeling, "Skip this section", value: "" %></div>
      </div>
      <%= render "shared/field_error", record: @submission, attribute: :satisfaction_feeling %>
    </fieldset>
    <%= render "text_field", form: form, attribute: :satisfaction_notes, label: "When…", hint: "Write a list of moments or situations. Use separate paragraphs if you'd like to explain them. To skip this section after starting, clear this answer and choose Skip this section.", rows: 6 %>
  </details>
  <details <%= "open" if @expanded_section == "projects" || @submission.profile_entries("projects").any? { |row| row.values.any?(&:present?) } %>>
    <summary>My project portfolio</summary>
    <%= render "repeated", form: form, field: "projects", title: "My project portfolio", singular: "Project" %>
  </details>
</section>
