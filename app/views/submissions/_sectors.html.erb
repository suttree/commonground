<fieldset class="choice-group" id="submission_<%= attribute %>" tabindex="-1">
  <legend><%= label %> (optional)</legend>
  <p class="hint">Choose all that apply.</p>
  <%= form.collection_check_boxes attribute, ProfileOptions::SECTORS, :itself, :itself do |choice| %>
    <div class="check-choice"><%= choice.check_box %><%= choice.label %></div>
  <% end %>
  <%= render "shared/field_error", record: @submission, attribute: attribute %>
</fieldset>
