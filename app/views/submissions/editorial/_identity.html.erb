<div class="story-identity-row">
  <div class="field"><%= form.label :name, "Your name · public" %><%= form.text_field :name, required: true, maxlength: 200, placeholder: "e.g. Nika van Olst", autocomplete: "name", **field_options(@submission, :name) %><%= render "shared/field_error", record: @submission, attribute: :name %></div>
  <%= render "submissions/editorial/photo" %>
</div>
<%= render "submissions/editorial/field", form: form, attribute: :skills_summary, label: "In your own words", placeholder: "e.g. I bring neighbours together around food, circular ideas and small local experiments.", hint: "A short introduction. A couple of sentences in your own words." %>
<div class="story-purpose"><%= render "submissions/editorial/field", form: form, attribute: :purpose, label: "What matters to you", required: true, placeholder: "e.g. I want good food to reach people, rather than go to waste.", hint: "Who or what would you like your work to help?" %></div>
<div class="field"><%= form.label :location, "Location (optional) · public" %><%= form.text_field :location, list: "profile-locations", maxlength: 5000, placeholder: "Start typing your city…", autocomplete: "off", **field_options(@submission, :location, hint: true) %><datalist id="profile-locations"><% @location_suggestions.each do |location| %><option value="<%= location %>"></option><% end %></datalist><p id="location-hint" class="hint">Suggestions come from public community profiles. Choose one or enter your own city and country. No street address.</p><%= render "shared/field_error", record: @submission, attribute: :location %></div>
<div class="field"><%= form.label :radius_km, "Travel radius in kilometres (optional) · public" %><%= form.number_field :radius_km, min: 0, max: 20000, step: "any", placeholder: "e.g. 25", **field_options(@submission, :radius_km) %><%= render "shared/field_error", record: @submission, attribute: :radius_km %></div>
<div class="field"><%= form.label :website, "A link to your work (optional) · public" %><%= form.url_field :website, maxlength: 500, placeholder: "https://your-website.com", **field_options(@submission, :website) %><%= render "shared/field_error", record: @submission, attribute: :website %></div>
<%= render "submissions/sections/contact", form: form %>
