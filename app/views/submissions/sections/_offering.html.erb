<fieldset>
  <legend>Purpose & impact</legend>
  <%= render "submissions/text_field", form: form, attribute: :mission, label: "We exist to…", required: true %>
  <%= render "submissions/text_field", form: form, attribute: :purpose, label: "We strive to positively impact the lives of…", required: true %>
