<div class="quiz-answers">
  <% target_ids.each do |id| %>
    <% goal = ProfileOptions::GOALS.find { |entry| entry.fetch("id") == id.split(".").first } %>
    <article class="quiz-answer">
      <p class="eyebrow">Goal <%= goal.fetch("id") %> · <%= goal.fetch("name") %></p>
      <h3><%= SdgQuiz::LABELS.fetch(id) %></h3>
      <% if local_assigns[:notes]&.key?(id) %><p><%= notes.fetch(id) %></p><% end %>
      <details><summary>Read target <%= id %></summary><p><%= ProfileOptions::TARGETS.fetch(id).fetch("text") %></p></details>
    </article>
  <% end %>
</div>
