<div class="quiz-page narrow">
  <%= render "progress", step: 2 %>
  <h1>Where would you put your energy?</h1>
  <p>Choose up to three priorities across your topics. One or two is enough.</p>
  <p class="small-note">These short labels describe the themes. Open a target to read its full wording, including dates and commitments.</p>
  <%= form_with url: quiz_path do %>
    <% @goal_ids.each do |id| %><%= hidden_field_tag "goals[]", id %><% end %>
    <% SdgQuiz.goals(@goal_ids).each do |goal| %>
      <fieldset>
        <legend><%= goal.fetch("name") %></legend>
        <% goal.fetch("targets").each do |target| %>
          <% id = target.fetch("id") %>
          <div class="quiz-target">
            <div class="check-choice">
              <%= check_box_tag "targets[]", id, @target_ids.include?(id), id: "target-#{id}" %>
              <%= label_tag "target-#{id}", SdgQuiz::LABELS.fetch(id) %>
            </div>
            <details><summary>Read target <%= id %></summary><p><%= target.fetch("text") %></p></details>
          </div>
        <% end %>
      </fieldset>
    <% end %>
    <div class="actions">
      <button class="button" name="step" value="results">See my answers</button>
      <button class="button secondary" name="step" value="topics">Change topics</button>
    </div>
  <% end %>
</div>
