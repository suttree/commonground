<div class="quiz-page narrow">
  <%= render "progress", step: 3 %>
  <h1>Your priorities, for now.</h1>
  <p>You chose <%= pluralize(@target_ids.size, "problem") %> to work on. Use these as a starting point when you talk about the work you're looking for.</p>
  <%= render "answers", target_ids: @target_ids %>
  <p class="small-note">These are your selections, not a score or an assessment. They haven't been saved to a profile.</p>
  <%= form_with url: quiz_path do %>
    <% @goal_ids.each do |id| %><%= hidden_field_tag "goals[]", id %><% end %>
    <% @target_ids.each do |id| %><%= hidden_field_tag "targets[]", id %><% end %>
    <div class="actions"><button class="button secondary" name="step" value="targets">Change my answers</button><%= link_to "Start again", quiz_path %></div>
  <% end %>
</div>
