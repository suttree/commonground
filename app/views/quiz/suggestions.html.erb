<% content_for :title, "Your suggested priorities" %>
<div class="quiz-page narrow">
  <p class="eyebrow">Your suggested priorities</p>
  <h1><%= @matches.any? ? "A starting point for your next project." : "Still exploring? That's fine." %></h1>
  <% if @matches.any? %>
    <p>These problems connect to the choices you made. See which ones feel worth exploring.</p>
    <% @matches.each do |id, reasons| %>
      <article class="quiz-answer">
        <p class="eyebrow">SDG target <%= id %></p>
        <h3><%= SdgQuiz::LABELS.fetch(id) %></h3>
        <p class="small-note">Suggested because you chose:</p>
        <ul class="quiz-reasons"><% reasons.uniq.first(2).each do |reason| %><li><%= reason %></li><% end %></ul>
        <details><summary>Read the full target</summary><p><%= ProfileOptions::TARGETS.fetch(id).fetch("text") %></p><p><%= link_to "Target #{id} in the SDG directory", sdg_target_path(id) %></p></details>
      </article>
    <% end %>
    <p class="small-note">Each answer points to related SDG targets. We show up to three with the most connections; equal matches follow question order. This is a starting point, not an assessment of your values or skills.</p>
  <% else %>
    <p>You skipped every question, so we haven't suggested any priorities. You can try again whenever you're ready.</p>
  <% end %>
  <% if @error %><p class="error-summary" role="alert"><%= @error %></p><% end %>
  <%= form_with url: confirm_quiz_path do |form| %>
    <%= hidden_field_tag :profile_id, current_profile.id if current_profile %>
    <fieldset>
      <legend>Choose your priorities</legend>
      <p class="hint">Keep or change these suggestions. Choose up to three, or clear them to keep exploring. Confirmed priorities appear on your public profile; your answers stay private.</p>
      <%= hidden_field_tag "target_ids[]", "" %>
      <% 3.times do |index| %>
        <div class="field"><%= label_tag "priority_#{index}", "Priority #{index + 1} (optional)" %><%= select_tag "target_ids[]", grouped_options_for_select(ProfileOptions::GOALS.map { |goal| [goal.fetch("name"), goal.fetch("targets").map { |target| ["#{target.fetch('id')}: #{SdgQuiz::LABELS.fetch(target.fetch('id'))}", target.fetch("id")] }] }, @selected_targets[index]), include_blank: "Still exploring", id: "priority_#{index}" %></div>
      <% end %>
    </fieldset>
    <div class="actions"><%= form.submit(onboarding_person? ? "Continue to your profile" : "Find companies with these priorities", class: "button") %><%= link_to "Explore projects", challenges_path %></div>
  <% end %>

  <section class="quiz-next-steps" aria-labelledby="next-steps-heading">
    <h2 id="next-steps-heading">Prefer a conversation?</h2>
    <p>Start a conversation with Nika.</p>
    <%= form_with url: new_profile_contact_path("nika-van-olst-3e4265d5c4bf"), method: :get do %>
      <fieldset class="wizard-options">
        <legend>Choose one option</legend>
        <% ContactRequest::OPTIONS.each do |intent, option| %>
          <label class="wizard-option next-step-option">
            <%= radio_button_tag :intent, intent, false, required: true %>
            <span><strong><%= option.fetch(:label) %></strong><span><%= option.fetch(:description) %></span></span>
          </label>
        <% end %>
      </fieldset>
      <button class="button">Continue</button>
    <% end %>
  </section>
  <div class="actions"><%= link_to "Review my answers", quiz_path(question: 0, profile_id: current_profile&.id), class: "button secondary" %></div>
  <%= form_with url: quiz_path do %><%= hidden_field_tag :profile_id, current_profile.id if current_profile %><button class="quiz-restart" name="restart" value="1">Start again</button><% end %>
  <% unless current_account %><p class="small-note quiz-footnote"><%= link_to "Create your account", new_person_path %> to build a profile. You can also browse companies without joining.</p><% end %>
  <% if current_profile %>
    <div class="actions"><%= link_to "Review profile", profile_path(current_profile.public_slug), class: "button" %></div>
  <% end %>
</div>
