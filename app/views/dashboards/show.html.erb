<% content_for :title, "Dashboard" %>
<div class="form-page dashboard">
  <header class="dashboard-heading">
    <p class="eyebrow"><%= @profile&.organisation? ? "Company dashboard" : "Your dashboard" %></p>
    <h1><%= @profile ? link_to(@profile.display_name, profile_path(@profile.public_slug)) : "Welcome to Commonbound" %></h1>
    <% if @profile %><%= link_to "Edit profile", edit_account_profile_path, class: "button secondary dashboard-edit-profile" %><% end %>
  </header>
  <% if current_account.onboarding.present? && !current_account.submissions.exists?(kind: "person") %>
    <section class="onboarding-reminder"><h2>Pick up where you left off</h2><p>Your personal profile isn't public yet. Finish your priorities and short introduction when you're ready.</p><%= link_to "Continue setting up your profile", new_person_path, class: "button" %></section>
  <% end %>
  <section class="dashboard-work" aria-labelledby="manage-profiles-title">
    <h2 id="manage-profiles-title">Your profiles & projects</h2>
    <% profiles = current_account.submissions.order(:kind, :organisation_name, :name) %>
    <% if profiles.size > 1 %>
      <%= form_with url: switch_profile_path, method: :patch do |form| %>
        <div class="field"><%= form.label :selected_profile_id, "Manage profile" %><%= form.collection_select :selected_profile_id, profiles, :id, :display_name, selected: @profile.id %></div>
        <%= form.submit "Switch profile", class: "button secondary" %>
      <% end %>
    <% end %>
    <div class="actions">
      <%= link_to "Create a company profile", new_organisation_path, class: "button secondary" %>
      <% unless profiles.any? { |profile| !profile.organisation? } %><%= link_to "Create a personal profile", new_person_path, class: "button secondary" %><% end %>
      <% if @profile %><%= link_to "Start a project", new_challenge_path, class: "button" %><% end %>
    </div>
    <p class="hint">Manage your personal and company profiles with this account. When you start a project, choose the profile it belongs to.</p>
  </section>
  <% if @profile %>
    <section class="dashboard-work" aria-labelledby="current-work-title">
      <h2 id="current-work-title">Your current project</h2>
      <% if @active_challenge %>
        <%= render "challenges/card", challenge: @active_challenge %>
        <div class="actions"><%= link_to "Update status or record results", edit_challenge_path(@active_challenge), class: "button secondary" %></div>
      <% else %><p>Share what you are working on and the help you need.</p><% end %>
      <% if @past_challenges.any? %><details class="challenge-optional"><summary>Your drafts & previous work</summary><ul class="work-archive"><% @past_challenges.each do |challenge| %><li><%= link_to challenge.title, challenge_path(challenge) %> <span class="status"><%= challenge.status.humanize %></span> <%= link_to "Edit", edit_challenge_path(challenge), aria: { label: "Edit #{challenge.title}" } %></li><% end %></ul></details><% end %>
    </section>
  <% end %>
  <div class="dashboard-columns">
    <section class="dashboard-quiz" aria-labelledby="dashboard-quiz-title">
      <p class="eyebrow">Sustainable Development Goals</p>
      <% if @profile&.priorities_selected? %>
        <h2 id="dashboard-quiz-title">Your current priorities</h2>
        <% if Array(@profile.target_ids).any? %>
          <ul class="dashboard-priorities"><% @profile.target_ids.each do |id| %><li><%= link_to "#{id}: #{SdgQuiz::LABELS.fetch(id)}", sdg_target_path(id) %></li><% end %></ul>
        <% else %>
          <p>You're still exploring which problems you want to work on.</p>
        <% end %>
        <p class="dashboard-retake"><%= link_to "Explore projects", challenges_path(goal: Array(@profile.target_ids).first.to_s.split(".").first.presence, status: "active") %> · <%= link_to "Review your priorities", edit_account_profile_path(section: "priorities", profile_id: @profile.id) %></p>
      <% else %>
        <h2 id="dashboard-quiz-title">Find the problems you want to work on</h2>
        <p>Discover your Sustainable Development Goal priorities through a short quiz.</p>
        <% if @profile %><p>Your results will be saved to your profile.</p><% end %>
        <%= link_to "Take the eight-question SDG quiz", quiz_path, class: "button" %>
        <% unless @profile %>
          <p class="dashboard-signup">Create a <%= link_to "personal profile", new_person_path %> or <%= link_to "company profile", new_organisation_path %> to save your results.</p>
        <% end %>
      <% end %>
    </section>
    <section class="dashboard-directories" aria-labelledby="dashboard-browse-title">
      <p class="eyebrow">Explore the community</p>
      <h2 id="dashboard-browse-title">Browse Commonbound</h2>
      <ul class="dashboard-directory-links">
        <li><h3><%= link_to "Projects", challenges_path %></h3><p>Find projects to contribute to and see completed work.</p></li>
        <li><h3><%= link_to "People directory", people_path %></h3><p>Find people who share your interests.</p></li>
        <li><h3><%= link_to "Company directory", companies_path %></h3><p>Explore organisations and the work they do.</p></li>
        <li><h3><%= link_to "Sustainable Development Goals directory", sdgs_path %></h3><p>Read the goals and discover their targets.</p></li>
      </ul>
    </section>
  </div>
  <% if @recommended_challenges&.any? %><section class="recent-work"><h2>Projects to explore</h2><p>Work connected to your selected goals, when you have added them.</p><div class="challenge-grid"><%= render partial: "challenges/card", collection: @recommended_challenges, as: :challenge %></div></section><% end %>
  <div class="dashboard-footer"><%= button_to "Log out", logout_path, method: :delete, class: "button secondary" %></div>
</div>
