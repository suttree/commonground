<% content_for :title, "Dashboard" %>
<% content_for :body_class, "dashboard-theme" %>
<%= javascript_include_tag "provocations", defer: true %>
<div class="form-page dashboard dashboard-overview-design">
  <header class="dashboard-heading">
    <p class="eyebrow"><%= @profile&.organisation? ? "Company dashboard" : "Your dashboard" %></p>
    <h1><%= @profile ? link_to(@profile.display_name, profile_path(@profile.public_slug)) : "Welcome to Commonbound" %></h1>
    <% if @profile %><%= link_to "Edit profile", edit_account_profile_path, class: "button secondary small dashboard-edit-profile" %><% end %>
  </header>
  <% if current_account.submissions.none? %>
    <%= render "journey" %>
  <% else %>
  <div class="dashboard-overview<%= " dashboard-overview-meta-only" unless @provocation_answer_count %>">
    <%= render "meta" %>
    <%= render "provocations" if @provocation_answer_count %>
  </div>
  <section class="dashboard-priorities-strip" aria-labelledby="dashboard-priorities-title">
    <div class="dashboard-section-heading">
      <h2 id="dashboard-priorities-title">What matters to you</h2>
      <% if @profile&.priorities_selected? %><%= link_to "Review your priorities", edit_account_profile_path(section: @profile&.organisation? ? "priorities" : "future", profile_id: @profile.id) %><% end %>
    </div>
    <% if @profile&.priorities_selected? %>
      <% if Array(@profile.target_ids).any? %>
        <ul class="dashboard-priority-links"><% @profile.target_ids.each do |id| %><li><%= link_to "#{id}: #{SdgQuiz::LABELS.fetch(id)}", sdg_target_path(id) %></li><% end %></ul>
      <% else %>
        <p class="small-note">You're still exploring which problems you want to work on.</p>
      <% end %>
    <% else %>
      <p class="small-note">Find the problems you want to work on. <%= link_to "Take the eight-question SDG quiz", quiz_path %></p>
      <% unless @profile %><p class="small-note">Create a <%= link_to "personal profile", new_person_path %> or <%= link_to "company profile", new_organisation_path %> to save your priorities.</p><% end %>
    <% end %>
  </section>
  <section class="dashboard-discovery" aria-labelledby="dashboard-browse-title">
    <div class="dashboard-section-heading">
      <h2 id="dashboard-browse-title">Find your next connection</h2>
      <%= link_to "Explore the goals", sdgs_path %>
    </div>
    <div class="dashboard-discovery-cards">
      <%= link_to challenges_path, class: "dashboard-discovery-card" do %><h3>Find a project <span aria-hidden="true">↗</span></h3><p>Put your skills to work on something that matters.</p><% end %>
      <%= link_to people_path, class: "dashboard-discovery-card" do %><h3>Meet people <span aria-hidden="true">↗</span></h3><p>Find people who care about the same problems.</p><% end %>
      <%= link_to companies_path, class: "dashboard-discovery-card" do %><h3>Explore companies <span aria-hidden="true">↗</span></h3><p>Get to know the teams doing useful work.</p><% end %>
    </div>
  </section>
  <section class="recent-work"><div class="dashboard-section-heading"><h2><%= Array(@profile&.target_ids).any? ? "Projects connected to your goals" : "Recent projects" %></h2><%= link_to "Browse all projects", challenges_path %></div>
    <% if @recommended_challenges&.any? %><div class="challenge-grid"><%= render partial: "challenges/card", collection: @recommended_challenges, as: :challenge %></div>
    <% else %><p>No matching active projects yet. <%= link_to "Browse projects", challenges_path %> or <%= link_to "Review your priorities", edit_account_profile_path(section: @profile&.organisation? ? "priorities" : "future") %>.</p><% end %>
  </section>
  <% end %>
  <div class="dashboard-footer"><%= button_to "Log out", logout_path, method: :delete, class: "button secondary" %></div>
</div>
