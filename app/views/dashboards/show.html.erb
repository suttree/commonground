<% content_for :title, "Dashboard" %>
<div class="form-page dashboard">
  <header class="dashboard-heading">
    <p class="eyebrow"><%= @profile&.organisation? ? "Company dashboard" : "Your dashboard" %></p>
    <h1><%= @profile ? link_to(@profile.display_name, profile_path(@profile.public_slug)) : "Welcome to Commonbound" %></h1>
  </header>
  <div class="dashboard-columns">
    <section class="dashboard-quiz" aria-labelledby="dashboard-quiz-title">
      <p class="eyebrow">Sustainable Development Goals</p>
      <% if @profile&.profile&.fetch("quiz_completed_at", nil).present? %>
        <h2 id="dashboard-quiz-title">Your current priorities</h2>
        <% if Array(@profile.target_ids).any? %>
          <ul class="dashboard-priorities"><% @profile.target_ids.each do |id| %><li><%= link_to "#{id}: #{SdgQuiz::LABELS.fetch(id)}", sdg_target_path(id) %></li><% end %></ul>
        <% else %>
          <p>You're still exploring which problems you want to work on.</p>
        <% end %>
        <p class="dashboard-retake"><%= link_to "Retake the quiz", quiz_path(question: 0) %></p>
      <% else %>
        <h2 id="dashboard-quiz-title">Find the problems you want to work on</h2>
        <p>Discover your Sustainable Development Goal priorities through a short quiz.</p>
        <% if @profile %><p>Your results will be saved to your profile.</p><% end %>
        <%= link_to "Take the eight-question SDG quiz", quiz_path, class: "button" %>
        <% unless @profile %>
          <p class="dashboard-signup">Create a <%= link_to "personal profile", new_person_path %> or <%= link_to "company profile", new_organisation_path %> to save your results.</p>
        <% end %>
      <% end %>
    </section>
    <section class="dashboard-directories" aria-labelledby="dashboard-browse-title">
      <p class="eyebrow">Explore the community</p>
      <h2 id="dashboard-browse-title">Browse Commonbound</h2>
      <ul class="dashboard-directory-links">
        <li><h3><%= link_to "People directory", people_path %></h3><p>Find people who share your interests.</p></li>
        <li><h3><%= link_to "Company directory", companies_path %></h3><p>Explore organisations and the work they do.</p></li>
        <li><h3><%= link_to "Sustainable Development Goals directory", sdgs_path %></h3><p>Read the goals and discover their targets.</p></li>
      </ul>
    </section>
  </div>
  <div class="dashboard-footer"><%= button_to "Log out", logout_path, method: :delete, class: "button secondary" %></div>
</div>
