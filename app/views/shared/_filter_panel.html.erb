<%# Desktop: an open, inline sidebar. Small screens: discovery_filters.js turns the same dialog into a modal sheet. %>
<aside class="discovery-sidebar" aria-labelledby="filters-heading" data-filter-panel>
  <h2 id="filters-heading" class="discovery-sidebar-title filters-sidebar-title">Filters</h2>
  <div class="discovery-search" role="search">
    <h2 class="discovery-sidebar-title">Search</h2>
    <%= label_tag :q, search_label, class: "sr-only" %>
    <%= search_field_tag :q, query, form: form_id, placeholder: search_label, autocomplete: "off", enterkeyhint: "search" %>
    <button class="button" form="<%= form_id %>">Search</button>
  </div>
  <button type="button" class="button secondary filter-open" aria-haspopup="dialog" aria-controls="filter-sheet" hidden data-filter-open>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20"><path d="M3 5h14M6 10h8M8.5 15h3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    Filters<% if active_count.positive? %> <span class="filter-count"><%= active_count %><span class="sr-only"> active</span></span><% end %>
  </button>
  <dialog class="filter-sheet" id="filter-sheet" aria-labelledby="filter-sheet-title" open data-filter-sheet>
    <div class="filter-sheet-header">
      <h2 id="filter-sheet-title" class="discovery-sidebar-title">Filters</h2>
      <button type="button" class="icon-button" aria-label="Close filters" data-filter-close>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="directory-filters">
      <%= yield %>
    </div>
    <div class="filter-sheet-actions">
      <button class="button filter-apply" form="<%= form_id %>">Apply filters</button>
      <%= link_to "Clear filters", clear_path, class: "filter-clear" %>
    </div>
  </dialog>
</aside>
<%= javascript_include_tag "discovery_filters", defer: true %>
