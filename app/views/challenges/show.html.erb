<% content_for :title, @challenge.title %>
<% content_for :body_class, "ink-lime-theme project-editorial" %>
<article class="challenge-detail">
  <p class="back-link"><%= link_to "All projects", challenges_path %> · <%= link_to @challenge.submission.display_name, profile_path(@challenge.submission.public_slug) %></p>
  <% if owns_profile?(@challenge.submission) %><div class="actions"><%= link_to "Edit project", edit_challenge_path(@challenge), class: "button secondary" %><%= link_to "Invite collaborators", challenge_collaborator_invitations_path(@challenge), class: "button secondary" %><%= link_to "Dashboard", dashboard_path %></div><% end %>
  <% unless @challenge.public? %><p class="notice">Only you can see this preview.</p><% end %>
  <div class="project-editorial-layout"><div class="project-story">
  <header class="project-editorial-heading">
    <p class="project-state <%= 'is-active' if @challenge.status == 'active' %>"><%= @challenge.status.humanize %> project</p>
    <h1><%= @challenge.title %></h1>
    <% if @challenge.completed_at %><p class="small-note">Completed <%= @challenge.completed_at.strftime("%B %Y") %></p><% end %>
  </header>
  <% paragraphs = @challenge.description.to_s.split(/\r?\n\s*\r?\n/, 2) %>
  <h2 class="project-about-label">About the project</h2>
  <div class="project-lead"><%= simple_format paragraphs.first %></div>
  <div class="prose">
    <% if @challenge.status == "active" %>
      <section class="challenge-help"><h2>Looking for help</h2>
        <% if @challenge.help_options.any? %><ul class="help-options"><% @challenge.help_options.each do |option| %><li><%= option %></li><% end %></ul><% else %><p>Start a conversation about how you could contribute.</p><% end %>
        <% if @challenge.public? %><%= link_to "Get involved", new_profile_contact_path(@challenge.submission.public_slug, challenge_id: @challenge.id), class: "button" %><p class="hint">Send a private request to the Commonbound team for <%= @challenge.submission.display_name %>. The team will help arrange a reply.</p><% end %>
      </section>
    <% end %>
    <%= simple_format paragraphs.last if paragraphs.size > 1 %>
    <% { objectives: "Mission & objectives", target: "Targets" }.each do |field, label| %>
      <% if @challenge.public_send(field).present? %><section><h2><%= label %></h2><%= simple_format @challenge.public_send(field) %></section><% end %>
    <% end %>
    <% if @challenge.completed? %>
      <% { project_role: "My role", context: "Context", approach: "The approach", results: "Results & what changed" }.each do |field, label| %><section><h2><%= label %></h2><%= simple_format @challenge.public_send(field) %></section><% end %>
      <% if @challenge.validated_project_url.present? %><p><%= link_to "Visit the project website", @challenge.validated_project_url, rel: "noopener noreferrer" %></p><% end %>
    <% end %>
  </div>
  </div><aside class="project-identity" aria-label="People and context behind the project">
    <%= render "shared/member_identity", profile: @challenge.submission %>
    <p class="small-note">A project by</p>
    <h2><%= link_to @challenge.submission.display_name, profile_path(@challenge.submission.public_slug) %></h2>
    <%= render "challenges/organisation", challenge: @challenge %>
    <% if @challenge.location.present? %><p class="project-place"><span aria-hidden="true">📍</span> <%= @challenge.location %></p><% end %>
    <% if @challenge.industry.present? %><p class="small-note"><%= link_to @challenge.industry, challenges_path(industry: @challenge.industry) %></p><% end %>
    <% if @challenge.target_ids.any? %><section><h2>Working towards</h2><ul><% @challenge.target_ids.each do |id| %><li class="project-goal sdg-color-<%= id.to_s.split(".").first.to_i %>"><span class="project-goal-number" aria-hidden="true"><%= id.to_s.split(".").first %></span><%= link_to "#{id}: #{SdgDirectory::LABELS.fetch(id)}", sdg_target_path(id) %></li><% end %></ul></section><% end %>  </aside></div>
  <%= render "collaborators" %>
</article>
