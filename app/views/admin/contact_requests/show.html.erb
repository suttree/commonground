<% content_for :title, "Conversation request" %>
<section class="page-intro narrow compact"><p><%= link_to "All requests", admin_contact_requests_path %></p><h1><%= @request.name %></h1>
<dl class="answers"><dt>For</dt><dd><%= @request.submission.display_name %></dd><dt>Request</dt><dd><%= ContactRequest::OPTIONS.fetch(@request.intent).fetch(:label) %></dd><dt>Email</dt><dd><%= @request.email %></dd><% if @request.challenge %><dt>Challenge</dt><dd><%= @request.challenge.title %></dd><% end %><dt>Message</dt><dd><%= simple_format @request.message %></dd><dt>Included quiz suggestions</dt><dd><% if @request.target_ids.any? %><ul><% @request.target_ids.each do |id| %><li><%= link_to SdgDirectory::LABELS.fetch(id), sdg_target_path(id) %></li><% end %></ul><% else %>None<% end %></dd><dt>Permission to contact</dt><dd><%= @request.consented_at.strftime("%d %b %Y %H:%M UTC") %></dd></dl></section>
