<% content_for :title, @company ? "Company directory" : "People directory" %>
<% content_for :body_class, "ink-lime-theme discovery-theme " %>
<div class="form-page">
  <%= render "shared/discovery_nav", current_section: @company ? "companies" : "people" %>
  <%= render "shared/discovery_intro", title: @company ? "Company directory" : "People directory", description: @company ? "Find companies by name, location, sector or shared goals." : "Find people by name, skill, location, sector or shared goals." %>
  <% if @use_priorities %><p class="notice"><%= @priority_goals.any? ? "Showing profiles connected to your selected goals." : "No priorities selected yet. Explore all profiles." %> <%= link_to "Show all", @company ? companies_path : people_path %></p><% end %>
  <% if current_account %>
  <% path = @company ? companies_path : people_path %>
  <% noun = @company ? "companies" : "people" %>
  <%= form_with url: path, method: :get, id: "directory-filters" do %><%= hidden_field_tag :priorities, "1" if @use_priorities %><% end %>
  <div class="discovery-layout">
  <% active_count = request.query_parameters.slice("skill", "location", "sector", "goal", "target", "priorities").count { |_key, value| value.present? } %>
  <%= render layout: "shared/filter_panel", locals: { form_id: "directory-filters", search_label: "Search #{noun} by name", query: @query, clear_path: path, active_count: active_count } do %>
      <% unless @company %><div class="field"><%= label_tag :skill, "Skill" %><%= search_field_tag :skill, @skill, form: "directory-filters", placeholder: "e.g. Research" %></div><% end %>
      <div class="field"><%= label_tag :location, "Location" %><%= search_field_tag :location, @location, form: "directory-filters", placeholder: "Any location" %></div>
      <div class="field"><%= label_tag :sector, "Sector" %><%= select_tag :sector, options_for_select(ProfileOptions::SECTORS, @sector), include_blank: "All sectors", form: "directory-filters", data: { auto_submit: true } %></div>
      <div class="field"><%= label_tag :goal, "SDG goal" %><%= select_tag :goal, options_for_select(ProfileOptions::GOALS.map { |goal| [goal.fetch("name"), goal.fetch("id")] }, @goal), include_blank: "All goals", form: "directory-filters", data: { auto_submit: true } %></div>
      <% if @target.present? %>
        <div class="field"><%= label_tag :target, "SDG target" %><%= select_tag :target, options_for_select(SdgDirectory::LABELS.map { |id, label| ["#{id}: #{label}", id] }, @target), include_blank: "All targets", form: "directory-filters", data: { auto_submit: true } %></div>
      <% end %>
  <% end %>
  <div class="discovery-results">
      <p class="discovery-count" role="status"><%= pluralize(@count, @company ? "company" : "person", plural: @company ? "companies" : "people") %></p>
  <%= render "shared/applied_filters", filters: request.query_parameters %>
  <div class="directory-grid">
    <% @profiles.each do |profile| %>
      <article class="directory-card">
        <div class="directory-identity">
        <%= render "shared/member_identity", profile: profile %>
        <div>
        <h2><%= link_to profile.display_name, profile_path(profile.public_slug) %></h2>
        <p class="directory-location"><%= profile.location.presence || "Location not added" %></p>
        </div></div>
        <p><%= truncate(profile.sector_reason.presence || profile.purpose, length: 220) %></p>
        <% if @sector.present? %><p class="small-note"><%= @sector %></p><% end %>
        <% if @skill.present? %><p class="small-note"><%= @skill %></p><% end %>
        <% goal_ids = Array(profile.target_ids).map { |id| id.split(".").first }.uniq %>
        <ul class="directory-goals">
          <% ProfileOptions::GOALS.select { |goal| goal_ids.include?(goal.fetch("id")) }.each do |goal| %>
            <li class="sdg-color-<%= goal.fetch("id") %>"><span class="goal-dot" aria-hidden="true"></span><%= link_to "SDG #{goal.fetch('id')}: #{goal.fetch('name')}", sdg_goal_path(goal.fetch("id")) %></li>
          <% end %>
        </ul>
        <%= link_to @company ? "Meet the company →" : "View profile →", profile_path(profile.public_slug), class: "directory-read-more" %>
      </article>
    <% end %>
  </div>
  <% if @profiles.empty? %>
    <div class="empty-state">
      <% if active_count.positive? || @query.present? %>
        <p>No <%= noun %> match these filters. Try another name or remove a filter.</p>
        <p><%= link_to "Clear all filters", path, class: "button secondary small" %></p>
      <% else %>
        <p>No <%= noun %> to show yet. Meanwhile, you can browse projects looking for help.</p>
        <p><%= link_to "Browse projects", challenges_path, class: "button secondary small" %></p>
      <% end %>
    </div>
  <% end %>
  <nav aria-label="Directory pages">
    <% if @page > 1 %><%= link_to "Previous", url_for(priorities: @use_priorities ? "1" : nil, q: @query, skill: @skill, location: @location, sector: @sector, goal: @goal, target: @target, page: @page - 1) %><% end %>
    <% if @page * 24 < @count %><%= link_to "Next", url_for(priorities: @use_priorities ? "1" : nil, q: @query, skill: @skill, location: @location, sector: @sector, goal: @goal, target: @target, page: @page + 1) %><% end %>
  </nav>
  </div>
  </div>
  <% else %>
    <%= render "shared/discovery_signup" %>
  <% end %>
</div>
