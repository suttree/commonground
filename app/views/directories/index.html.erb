<% content_for :title, @company ? "Company directory" : "People directory" %>
<div class="form-page">
  <h1><%= @company ? "Company directory" : "People directory" %></h1>
  <p>Find <%= @company ? "companies" : "people" %> by name, location, sector or the goals they want to work on.</p>
  <%= form_with url: @company ? companies_path : people_path, method: :get, class: "directory-filters" do |form| %>
    <div class="field"><%= form.label :q, "Name" %><%= form.search_field :q, value: @query %></div>
    <div class="field"><%= form.label :location, "Location" %><%= form.search_field :location, value: @location %></div>
    <div class="field"><%= form.label :sector, "Sector" %><%= form.select :sector, options_for_select(ProfileOptions::SECTORS, @sector), include_blank: "All sectors" %></div>
    <div class="field"><%= form.label :goal, "SDG goal" %><%= form.select :goal, options_for_select(ProfileOptions::GOALS.map { |goal| [goal.fetch("name"), goal.fetch("id")] }, @goal), include_blank: "All goals" %></div>
    <% if @target.present? %>
      <div class="field"><%= form.label :target, "SDG target" %><%= form.select :target, options_for_select(SdgDirectory::LABELS.map { |id, label| ["#{id}: #{label}", id] }, @target), include_blank: "All targets" %></div>
    <% end %>
    <%= form.submit "Search", class: "button" %>
    <%= link_to "Clear filters", @company ? companies_path : people_path %>
  <% end %>
  <p role="status"><%= pluralize(@count, "profile") %> found.</p>
  <div class="directory-grid">
    <% @profiles.each do |profile| %>
      <article class="directory-card">
        <h2><%= link_to profile.display_name, profile_path(profile.public_slug) %></h2>
        <% if profile.location.present? %><p><%= profile.location %></p><% end %>
        <p><%= truncate(profile.purpose, length: 220) %></p>
        <p><%= (Array(profile.sectors_past) + Array(profile.sectors_future)).uniq.join(" · ") %></p>
        <% goal_ids = Array(profile.target_ids).map { |id| id.split(".").first }.uniq %>
        <ul>
          <% ProfileOptions::GOALS.select { |goal| goal_ids.include?(goal.fetch("id")) }.each do |goal| %>
            <li><%= link_to "SDG #{goal.fetch('id')}: #{goal.fetch('name')}", sdg_goal_path(goal.fetch("id")) %></li>
          <% end %>
        </ul>
      </article>
    <% end %>
  </div>
  <% if @profiles.empty? %><p>No profiles match. Try another name or remove a filter.</p><% end %>
  <nav aria-label="Directory pages">
    <% if @page > 1 %><%= link_to "Previous", url_for(q: @query, location: @location, sector: @sector, goal: @goal, target: @target, page: @page - 1) %><% end %>
    <% if @page * 24 < @count %><%= link_to "Next", url_for(q: @query, location: @location, sector: @sector, goal: @goal, target: @target, page: @page + 1) %><% end %>
  </nav>
</div>
